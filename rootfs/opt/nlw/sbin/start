#!/usr/bin/env bash
#
# Entrypoint van de kerncontainer. Alles wat moet blijven bestaan staat op het volume in /data:
#   pgdata/              PostgreSQL
#   softhsm/, home/      HSM-token en softhsm2.conf
#   devenv-target/       scripts/devenv/target: CA's, sleutels, certificaten
#   wallet-core-target/  wallet_core/target: statuslijsten
#   rdo-max-secrets/     sleutels van de mock-DigiD
#   gegenereerd.tar      de configuratiebestanden die de inrichting in de checkout schreef
#
# Sleutels en configuratie horen bij elkaar: de publieke HSM-sleutels staan in de getekende
# wallet-config en in de certificaten. Een nieuw volume is dus een nieuwe omgeving, en wallets
# die tegen de oude geregistreerd zijn werken daarna niet meer.

set -euo pipefail

source /opt/nlw/sbin/omgeving

# Onder een willekeurige uid (zie het Containerfile) is er geen passwd-regel; initdb weigert dan
# en softhsm2 vindt geen thuismap. Voeg er een toe.
echo "Draait als $(id)"
if ! getent passwd "$(id -u)" > /dev/null; then
	echo "wallet:x:$(id -u):0:NL Wallet:${HOME}:/bin/bash" >> /etc/passwd
fi

# De publieke adressen zitten in sleutels, certificaten en de getekende wallet-config op het
# volume. Veranderen ze (ander domein, nieuw subdomein goedgekeurd), dan is dit een andere
# omgeving: alles op het volume weg en opnieuw inrichten. ZAD's --recreate-storage doet dat
# ook, maar faalde op het platform ("NoneType + int"), en dit werkt ook zonder ZAD.
if [[ -f "${NLW_DATA}/ingericht" && "$(sed -n 2p "${NLW_DATA}/ingericht")" != "${NLW_URL_PID}" ]]; then
	echo "Volume is ingericht voor $(sed -n 2p "${NLW_DATA}/ingericht"), nu geldt ${NLW_URL_PID}: opnieuw beginnen"
	find "${NLW_DATA}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
fi

mkdir -p "${HOME}" "${NLW_DATA}/devenv-target" "${NLW_DATA}/wallet-core-target" "${NLW_DATA}/rdo-max-secrets"

koppel() {
	rm -rf "$2"
	ln -s "$1" "$2"
}
koppel "${NLW_DATA}/devenv-target" /opt/nl-wallet/scripts/devenv/target
koppel "${NLW_DATA}/wallet-core-target" /opt/nl-wallet/wallet_core/target
koppel "${NLW_DATA}/rdo-max-secrets" /opt/nl-rdo-max/secrets

if [[ -f "${NLW_DATA}/gegenereerd.tar" ]]; then
	tar -xpf "${NLW_DATA}/gegenereerd.tar" -C /
fi

# Welke browser-origins de verification_server toelaat (CORS): de knop van wallet_web vraagt de
# sessiestatus rechtstreeks bij de publieke verifier op. De inrichting zet alleen MOZA_ORIGIN;
# een PR-preview van MOZa heeft een andere hostnaam. Dit staat los van de sleutels op het volume,
# dus het mag bij elke start opnieuw, uit NLW_ALLOW_ORIGINS (JSON-lijst of "*", standaard "*").
vs_toml=/opt/nl-wallet/wallet_core/wallet_server/verification_server/verification_server.toml
if [[ -f "${vs_toml}" ]]; then
	python3 - "${vs_toml}" "${NLW_ALLOW_ORIGINS:-*}" <<'PY'
import re, sys
pad, origins = sys.argv[1:3]
waarde = '"*"' if origins.strip() == "*" else origins
tekst = open(pad, encoding="utf-8").read()
tekst, n = re.subn(r"^allow_origins = .*$", "allow_origins = " + waarde, tekst, count=1, flags=re.M)
if n:
    open(pad, "w", encoding="utf-8").write(tekst)
print("allow_origins =", waarde if n else "(niet gevonden)")
PY
fi

if [[ ! -f "${NLW_DATA}/ingericht" ]]; then
	echo "Eerste start op dit volume: omgeving inrichten"
	touch /tmp/voor-inrichting
	sleep 1
	/opt/nlw/sbin/inrichten
	find /opt/nl-wallet /opt/nl-rdo-max -newer /tmp/voor-inrichting \( -type f -o -type l \) -print0 \
		| tar --null -cpf "${NLW_DATA}/gegenereerd.tar" -T -
	# Regel 1: wanneer; regel 2: voor welke adressen (zie de controle hierboven).
	printf '%s\n%s\n' "$(date -u +%FT%TZ)" "${NLW_URL_PID}" > "${NLW_DATA}/ingericht"
fi

pgbin="$(echo /usr/lib/postgresql/*/bin)"
if [[ ! -f "${NLW_DATA}/pgdata/PG_VERSION" ]]; then
	"${pgbin}/initdb" --pgdata="${NLW_DATA}/pgdata" --username=postgres --auth=trust --encoding=UTF8 --locale=C.UTF-8
fi
# Kubernetes verruimt bij het koppelen van het volume de groepsrechten (fsGroup); PostgreSQL
# weigert dan te starten ("data directory has invalid permissions"). Elke start terugzetten.
chmod 0700 "${NLW_DATA}/pgdata"
export NLW_PGBIN="${pgbin}"

rm -f /tmp/migraties-klaar
exec supervisord --nodaemon --configuration /opt/nlw/supervisord.conf
