#!/usr/bin/env bash
#
# Start één NL Wallet-service vanuit zijn crate-map, zoals start-devenv.sh (de services lezen
# <naam>.toml uit de werkmap). Wacht eerst op de migraties.
#
# Gebruik: dienst <binary> <map onder wallet_core>

set -euo pipefail

source /opt/nlw/sbin/omgeving

until [[ -f /tmp/migraties-klaar ]]; do
	sleep 1
done

cd "/opt/nl-wallet/wallet_core/$2"
# Alle services loggen naar dezelfde stdout (zad logs). De naam ervoor maakt zichtbaar welk proces
# iets meldt; zonder was een HSM-fout ("ERROR r2d2 ...") niet aan een service toe te wijzen. Via
# procesvervanging, zodat exec het proces-id houdt en supervisord de service zelf kan stoppen.
exec "/opt/nlw/bin/$1" > >(sed -u "s/^/[$1] /") 2>&1
